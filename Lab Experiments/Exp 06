
import random

text = "I love machine learning. I love Python. Python is easy to learn."

# Convert text into words
words = text.lower().replace(".", "").split()

# Create bigram model
bigram = {}

for i in range(len(words)-1):
    word = words[i]
    next_word = words[i+1]

    if word not in bigram:
        bigram[word] = []
    bigram[word].append(next_word)

# Generate text
word = "i"
result = [word]

for i in range(10):
    if word not in bigram:
        break
    word = random.choice(bigram[word])
    result.append(word)

print("Generated Text:")
print(" ".join(result))
